# Dependencies
node_modules/

# Environment & secrets (never commit)
.env
.env.local
.env.*.local
!.env.example

# SQLite / local data
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
data/backups/
!data/.gitkeep

# Uploads (payment proofs = customer bank/UPI screenshots).
# Served only via the authenticated /admin/proof route, never by express.static.
data/uploads/
public/uploads/**
!public/uploads/.gitkeep

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Test / coverage
coverage/
.nyc_output/

# Build / cache
.cache/
tmp/
temp/
