# ── IndiaOffers E-Mystery → https://mystery.indiaoffers.in ──

PORT=3100
NODE_ENV=development

# Local dev (default). Production:
# NODE_ENV=production
# SITE_URL=https://mystery.indiaoffers.in
# SITE_HOST=mystery.indiaoffers.in
SITE_URL=http://localhost:3100
SITE_HOST=mystery.indiaoffers.in
SITE_NAME=IndiaOffers E-Mystery

JWT_SECRET=change-me-to-a-long-random-string

COMPANY_NAME=IndiaOffers.in
COMPANY_URL=https://indiaoffers.in
SUPPORT_EMAIL=care@indiaoffers.in
SUPPORT_WHATSAPP=919569608101

# Payment (UPI / bank on pay page)
MYSTERY_UPI_ID=indiaoffers@upi
MYSTERY_UPI_NAME=IndiaOffers
MYSTERY_BANK_NAME=IndiaOffers
MYSTERY_BANK_ACCOUNT=
MYSTERY_BANK_IFSC=
MYSTERY_BANK=

# Instant test payment — leave off in production
MYSTERY_TEST_PAY=1

# Optional SMTP (without it, emails log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IndiaOffers E-Mystery <noreply@indiaoffers.in>

# First admin (used by npm run seed) — set your own; never commit real secrets
ADMIN_EMAIL=
ADMIN_PASSWORD=
