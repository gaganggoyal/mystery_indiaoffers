# ── IndiaOffers E-Mystery → https://mystery.indiaoffers.in ──
#
# Copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env
#
# In production the app validates this file on boot and REFUSES TO START if
# JWT_SECRET is weak/placeholder, SITE_URL isn't https, or MYSTERY_TEST_PAY
# is still on. Read the error, fix the value, restart.

PORT=3100
NODE_ENV=development

# ── Site identity ─────────────────────────────────────────────────────────
# Dev default below. In production BOTH must be the real https URL — they are
# baked into the pay and report links emailed to customers.
SITE_URL=http://localhost:3100
SITE_HOST=mystery.indiaoffers.in
SITE_NAME=IndiaOffers E-Mystery

# ── Secrets ───────────────────────────────────────────────────────────────
# Generate a fresh one per environment:  openssl rand -hex 32
# Must be >= 32 chars in production. Changing it logs out all admins.
JWT_SECRET=change-me-to-a-long-random-string

# ── Brand / support ───────────────────────────────────────────────────────
COMPANY_NAME=IndiaOffers.in
COMPANY_URL=https://indiaoffers.in
SUPPORT_EMAIL=care@indiaoffers.in
SUPPORT_WHATSAPP=919569608101

# ── Payment (shown on the pay page) ───────────────────────────────────────
# Set the real UPI ID before taking live orders, or customers pay nobody.
MYSTERY_UPI_ID=indiaoffers@upi
MYSTERY_UPI_NAME=IndiaOffers
MYSTERY_BANK_NAME=IndiaOffers
MYSTERY_BANK_ACCOUNT=
MYSTERY_BANK_IFSC=
MYSTERY_BANK=

# ── Instant "test payment" button ─────────────────────────────────────────
# Marks an order paid with no money changing hands. Dev only.
# Production boot FAILS while this is 1 — leave it unset/0 on the VPS.
MYSTERY_TEST_PAY=1

# ── Optional SMTP ─────────────────────────────────────────────────────────
# Without SMTP_HOST, customer emails are only written to the log — orders
# still work, but nobody receives their pay link or report.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IndiaOffers E-Mystery <noreply@indiaoffers.in>

# ── Storage (optional) ────────────────────────────────────────────────────
# Point these at a backed-up volume if you don't want data inside the deploy
# directory. UPLOAD_DIR holds payment proofs and must stay outside public/.
# DATA_DIR=/var/lib/emystery
# UPLOAD_DIR=/var/lib/emystery/uploads

# ── First admin (used by `npm run seed`) ──────────────────────────────────
# Set both, run the seed once, then blank them out again.
# If unset, seed prints a random password to the terminal — save it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
