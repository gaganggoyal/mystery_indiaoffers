; systemd unit for IndiaOffers E-Mystery (mystery.indiaoffers.in)
;
;   sudo cp deploy/mystery-indiaoffers.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now mystery-indiaoffers
;   sudo systemctl status mystery-indiaoffers
;   journalctl -u mystery-indiaoffers -f
;
; Secrets (JWT_SECRET, SMTP_PASS, …) belong in the EnvironmentFile below,
; which should be chmod 600 and owned by the service user — never in this file,
; because unit files are world-readable.

[Unit]
Description=IndiaOffers E-Mystery (mystery.indiaoffers.in)
Documentation=https://github.com/gaganggoyal/mystery_indiaoffers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

; Dedicated unprivileged user:
;   sudo useradd --system --home /var/www/indiaoffers-emystery --shell /usr/sbin/nologin emystery
User=emystery
Group=emystery

WorkingDirectory=/var/www/indiaoffers-emystery
EnvironmentFile=/var/www/indiaoffers-emystery/.env
Environment=NODE_ENV=production
Environment=PORT=3100

ExecStart=/usr/bin/node src/server.js

; Graceful drain — server.js closes the listener and SQLite on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

; Don't let a crash-loop hammer the box.
StartLimitIntervalSec=60
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=emystery

; ── Sandboxing ────────────────────────────────────────────────────────────
; The app only ever writes to its data/ directory (SQLite + payment proofs).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

; The only writable path. Add more here if you move DATA_DIR elsewhere.
ReadWritePaths=/var/www/indiaoffers-emystery/data

[Install]
WantedBy=multi-user.target
