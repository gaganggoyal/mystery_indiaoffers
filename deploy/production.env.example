# ── Production environment for https://mystery.indiaoffers.in ──────────────
#
# On the VPS:
#   cp deploy/production.env.example .env
#   chmod 600 .env
#   nano .env                      # fill in the TODOs
#
# Or generate it non-interactively (fills JWT_SECRET for you):
#   ./scripts/setup-production.sh
#
# The app validates this on boot and REFUSES TO START if anything here is
# unsafe. Check `journalctl -u mystery-indiaoffers -n 30` if it won't come up.

NODE_ENV=production
PORT=3100

# ── Domain ────────────────────────────────────────────────────────────────
# These are baked into every pay link and report link emailed to clients.
SITE_URL=https://mystery.indiaoffers.in
SITE_HOST=mystery.indiaoffers.in
SITE_NAME=IndiaOffers E-Mystery

# ── Secret ────────────────────────────────────────────────────────────────
# TODO: openssl rand -hex 32
# Must be >= 32 chars and must not be a placeholder. Rotating it logs out
# every admin session immediately.
JWT_SECRET=

# ── Brand / support ───────────────────────────────────────────────────────
COMPANY_NAME=IndiaOffers.in
COMPANY_URL=https://indiaoffers.in
SUPPORT_EMAIL=care@indiaoffers.in
SUPPORT_WHATSAPP=919569608101

# ── Payment ───────────────────────────────────────────────────────────────
# TODO: real UPI ID — this is what clients actually pay into.
MYSTERY_UPI_ID=
MYSTERY_UPI_NAME=IndiaOffers
# Optional bank details shown alongside UPI on the pay page.
MYSTERY_BANK_NAME=
MYSTERY_BANK_ACCOUNT=
MYSTERY_BANK_IFSC=
MYSTERY_BANK=

# Instant fake payment. MUST stay 0 in production — the app refuses to boot
# otherwise, because it would let anyone mark an order paid for free.
MYSTERY_TEST_PAY=0

# ── Review before payment ─────────────────────────────────────────────────
# On by default: booking takes no money, the client is told you'll email a
# payment link within MYSTERY_REVIEW_SLA_HOURS, and you set the final figures
# in admin first. Recommended — the product deposit is otherwise derived from
# a cart estimate the client types in.
# Set to 0 to send clients straight to the pay page instead.
MYSTERY_REVIEW_BEFORE_PAY=1
MYSTERY_REVIEW_SLA_HOURS=24

# ── SMTP ──────────────────────────────────────────────────────────────────
# TODO: without these, clients never receive their pay link, payment
# confirmation, or finished report — the mails only go to the journal.
#
# SMTP_FROM must use an address the SMTP account is allowed to send as.
# Zoho (and most providers) reject anything else with
#   553 Sender is not allowed to relay emails
# even when the domain matches, and even when the mailbox exists. Creating the
# address is not enough on its own — the account in SMTP_USER has to be
# authorised to send as it. Either:
#   a) add it as an alias:  Zoho Mail → Settings → Mail Accounts →
#      <SMTP_USER> → Email Address → Add Alias → mystery@yourdomain
#   b) or authenticate as that mailbox directly (set SMTP_USER/SMTP_PASS to it)
# An address can only belong to one account, so if it already exists as its own
# mailbox, (a) fails with "alias already exists" until you delete that mailbox.
#
# Prefer a human-looking sender over noreply@: recipients are far likelier to
# add it to contacts, which is the strongest deliverability signal there is —
# and the copy in this app asks them to reply in several places.
#
# Note that the local part buys you nothing for reputation: mail reputation is
# scored per domain and IP, so mystery@ and noreply@ on the same domain are
# identical in the eyes of Gmail. Only a subdomain isolates reputation, and
# that starts from zero rather than inheriting the parent domain's history.
#
# SMTP_REPLY_TO is where replies land — keep it pointed at a monitored inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IndiaOffers E-Mystery <mystery@indiaoffers.in>
SMTP_REPLY_TO=care@indiaoffers.in

# ── Storage ───────────────────────────────────────────────────────────────
# Defaults to ./data. Point at a backed-up volume if you prefer.
# DATA_DIR=/var/lib/emystery
# UPLOAD_DIR=/var/lib/emystery/uploads

# ── Seeding only ──────────────────────────────────────────────────────────
# Leave blank. Use scripts/admin.js to manage accounts instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
