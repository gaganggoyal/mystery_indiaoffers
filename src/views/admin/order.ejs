<%- include('_layout-top') %>

<% if (saved) { %><div class="form-ok">Saved.</div><% } %>
<% if (published) { %><div class="form-ok">Report published &amp; client emailed.</div><% } %>
<% if (linksent) { %><div class="form-ok">Payment link emailed to the client. Order moved to “Awaiting payment”.</div><% } %>
<% if (confirmed) { %><div class="form-ok">Payment confirmed. Client emailed &amp; order queued for shopping.</div><% } %>
<% if (rejected) { %><div class="form-ok">Payment claim rejected. Client emailed and order returned to “awaiting payment”.</div><% } %>
<% if (err === 'confirm_payment') { %>
  <div class="form-err">
    Use <b>Confirm payment received</b> below to mark this order paid — that records who verified it
    and how much actually landed.
  </div>
<% } %>

<div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
  <div>
    <h1 style="color:var(--ink)"><%= order.order_code %></h1>
    <p class="muted"><%= order.plan_name %> · <%= formatInr(order.price_inr) %> ·
      <span class="status-chip" style="background:<%= statusMeta(order.status).color %>"><%= statusMeta(order.status).label %></span>
    </p>
  </div>
  <a class="btn-ghost btn-sm" href="/order/<%= order.order_code %>?t=<%= order.access_token %>" target="_blank">Client view ↗</a>
</div>

<div class="grid-3" style="margin-bottom:18px">
  <div class="card">
    <h3>Client</h3>
    <p style="margin-top:8px;font-size:14px"><b><%= order.client_name %></b><br><%= order.client_email %><br><%= order.client_phone || '—' %><br><%= order.client_company || '' %></p>
  </div>
  <div class="card">
    <h3>Target</h3>
    <p style="margin-top:8px;font-size:13.5px;word-break:break-all"><a href="<%= order.brand_url %>" target="_blank" style="color:var(--brand)"><%= order.brand_url %></a></p>
    <p class="muted" style="font-size:12.5px;margin-top:6px"><%= order.platform || '' %> · <%= order.category || '' %></p>
    <% if (competitors.length) { %><p style="font-size:12.5px;margin-top:6px">Competitors: <%= competitors.join(' | ') %></p><% } %>
  </div>
  <div class="card">
    <h3>Payment</h3>
    <p style="margin-top:8px;font-size:14px">
      Service fee: <b><%= formatInr(order.price_inr) %></b><br>
      Product deposit: <b><%= formatInr(order.product_deposit_inr || 0) %></b><br>
      <% if (order.return_addon) { %>Return add-on: yes<br><% } %>
      Total due: <b><%= formatInr((order.price_inr || 0) + (order.product_deposit_inr || 0)) %></b><br>
      Amount paid: <%= order.amount_paid != null ? formatInr(order.amount_paid) : '—' %><br>
      Method: <%= order.payment_method || '—' %><br>
      Ref: <%= order.payment_ref || '—' %><br>
      <% if (order.payment_claimed_at) { %>Client submitted: <%= order.payment_claimed_at %><br><% } %>
      Verified: <%= order.paid_at ? order.paid_at + (order.payment_verified_by ? ' by ' + order.payment_verified_by : '') : '— not verified' %><br>
      <% if (order.payment_proof) { /* tolerate legacy "/uploads/x.jpg" rows */ %>
        <a href="/admin/proof/<%= order.payment_proof.split('/').pop() %>" target="_blank" style="color:var(--brand)">Proof ↗</a>
      <% } %>
    </p>
  </div>
</div>

<% if (order.status === 'awaiting_review') { %>
  <%
    const indicativeTotal = (order.price_inr || 0) + (order.product_deposit_inr || 0);
  %>
  <div class="card" style="margin-bottom:18px;border-color:#8b5cf6">
    <h3>◆ Review this brief, then send the payment link</h3>
    <p class="muted" style="margin-top:6px;font-size:13.5px">
      The product deposit below was calculated from the cart estimate <b>the client typed
      in</b><% if (order.product_deposit_inr) { %> — check it against the real product page before
      sending<% } %>. On the Customized plan the client funds 100% of the product, so an
      under-estimate here is money you don't collect. Nothing has been quoted to them yet.
    </p>

    <form method="post" action="/admin/orders/<%= order.id %>" id="send_link_form" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="send_payment_link">
      <div class="two">
        <label>Service fee (₹)
          <input type="number" name="service_fee" min="0" step="1" value="<%= order.price_inr || 0 %>">
        </label>
        <label>Product deposit (₹)
          <input type="number" name="product_deposit" min="0" step="1" value="<%= order.product_deposit_inr || 0 %>">
        </label>
      </div>
      <label>Note to the client (optional — appears in the email)
        <input name="review_note" maxlength="500"
               placeholder="e.g. Cart came to ₹2,340 so the deposit is adjusted accordingly">
      </label>
      <button class="btn-primary" type="submit" style="margin-top:12px">
        ✉ Send payment link — currently <%= formatInr(indicativeTotal) %>
      </button>
      <p class="muted" style="margin-top:8px;font-size:12.5px">
        <%# admin renders don't receive the public `payment` local — read it off config. %>
        Emails the client a pay link<%= config.payment.upiId && config.payment.upiId !== 'indiaoffers@upi' ? ' with a prefilled UPI QR' : '' %>
        and moves the order to “Awaiting payment”.
      </p>
    </form>
  </div>
<% } %>

<% if (order.status === 'payment_review' || order.status === 'pending_payment') { %>
  <%
    const totalDue = (order.price_inr || 0) + (order.product_deposit_inr || 0);
    const claimed = order.status === 'payment_review';
  %>
  <div class="card" style="margin-bottom:18px;border-color:<%= claimed ? '#d97706' : 'var(--line)' %>">
    <h3><%= claimed ? '⚠ Payment claimed — verify before shopping' : 'Record a payment' %></h3>
    <p class="muted" style="margin-top:6px;font-size:13.5px">
      <% if (claimed) { %>
        The client entered these details themselves; they are <b>not</b> proof of payment.
        Match the reference against the bank/UPI statement before confirming — confirming
        authorises a shopper to start spending the product budget.
      <% } else { %>
        Use this once money lands (e.g. the client paid offline or by cheque).
      <% } %>
    </p>

    <form method="post" action="/admin/orders/<%= order.id %>" id="confirm_payment_form" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="confirm_payment">
      <div class="two">
        <label>Amount actually received (₹)
          <input type="number" name="amount_received" min="0" step="1" value="<%= totalDue %>">
        </label>
        <label>Bank / UPI reference
          <input name="payment_ref" value="<%= order.payment_ref || '' %>" placeholder="UTR / transaction id">
        </label>
      </div>
      <button class="btn-primary" type="submit" style="margin-top:12px">
        ✓ Confirm payment received — <%= formatInr(totalDue) %>
      </button>
    </form>

    <% if (claimed) { %>
      <form method="post" action="/admin/orders/<%= order.id %>" id="reject_payment_form" style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line)">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="action" value="reject_payment">
        <label style="font-size:13.5px">Can't find this payment? Reason (emailed to the client)
          <input name="reject_reason" maxlength="500" placeholder="e.g. No matching credit for this UTR">
        </label>
        <button class="btn-ghost btn-sm" type="submit" style="margin-top:10px;border-color:var(--bad);color:var(--bad)">
          Reject claim &amp; ask client to re-pay
        </button>
      </form>
    <% } %>
  </div>
<% } %>

<% if (order.product_notes || order.special_brief) { %>
  <div class="card" style="margin-bottom:16px">
    <h3>Brief</h3>
    <% if (order.product_notes) { %><p style="margin-top:8px;white-space:pre-wrap"><b>Product notes:</b> <%= order.product_notes %></p><% } %>
    <% if (order.special_brief) { %><p style="margin-top:8px;white-space:pre-wrap"><b>Special:</b> <%= order.special_brief %></p><% } %>
  </div>
<% } %>

<div class="card" style="margin-bottom:18px">
  <h3 style="margin-bottom:10px">Order ops</h3>
  <form method="post" action="/admin/orders/<%= order.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" value="save_order">
    <div class="two">
      <label>Status
        <select name="status">
          <% ORDER_STATUSES.forEach(s => { %>
            <option value="<%= s.id %>" <%= order.status === s.id ? 'selected' : '' %>><%= s.label %></option>
          <% }) %>
        </select>
      </label>
      <label>Assigned to<input name="assigned_to" value="<%= order.assigned_to || '' %>" placeholder="Shopper name"></label>
    </div>
    <div class="two">
      <label>ETA date<input type="date" name="eta_date" value="<%= order.eta_date || '' %>"></label>
      <label>Payment ref<input name="payment_ref" value="<%= order.payment_ref || '' %>"></label>
    </div>
    <label>Admin notes<textarea name="admin_notes" rows="3"><%= order.admin_notes || '' %></textarea></label>
    <button class="btn-primary" type="submit" style="margin-top:12px">Save order</button>
  </form>
</div>

<div class="card">
  <h3 style="margin-bottom:10px">Report scorecard</h3>
  <form method="post" action="/admin/orders/<%= order.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" value="save_report">
    <label>Verdict (headline)<input name="verdict" value="<%= report && report.verdict || '' %>" placeholder="Solid product, leaky checkout trust"></label>
    <label>Executive summary<textarea name="executive_summary" rows="4"><%= report && report.executive_summary || '' %></textarea></label>
    <div class="two">
      <label>Overall score (auto if blank)<input type="number" name="overall_score" min="0" max="100" value="<%= report && report.overall_score != null ? report.overall_score : '' %>"></label>
      <label>Would buy again?
        <select name="would_buy_again">
          <option value="">N/A</option>
          <option value="1" <%= report && report.would_buy_again === 1 ? 'selected' : '' %>>Yes</option>
          <option value="0" <%= report && report.would_buy_again === 0 ? 'selected' : '' %>>No</option>
        </select>
      </label>
    </div>

    <h4 style="margin:16px 0 8px;color:var(--ink)">Pillar scores &amp; notes</h4>
    <% pillars.forEach(p => { %>
      <div class="two">
        <label><%= p.label %> (max <%= p.max %>)
          <input type="number" name="score_<%= p.key %>" min="0" max="<%= p.max %>" value="<%= scores[p.key] != null ? scores[p.key] : '' %>">
        </label>
        <label>Notes
          <textarea name="section_<%= p.key %>" rows="2"><%= sections[p.key] || '' %></textarea>
        </label>
      </div>
    <% }) %>

    <label>Top fixes (one per line)<textarea name="top_fixes" rows="5" placeholder="Fix shipping fee reveal…&#10;Add size chart…"><%= fixes.join('\n') %></textarea></label>
    <label>Evidence notes<textarea name="evidence_notes" rows="3"><%= report && report.evidence_notes || '' %></textarea></label>
    <label>Extra notes<textarea name="section_extra" rows="2"><%= sections.extra || '' %></textarea></label>
    <label style="display:flex;align-items:center;gap:8px;font-weight:600">
      <input type="checkbox" name="set_in_progress" value="1" style="width:auto"> If paid, mark order in progress
    </label>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">
      <button class="btn-primary" type="submit">Save report draft</button>
    </div>
  </form>

  <form method="post" action="/admin/orders/<%= order.id %>" style="margin-top:12px" id="publish_form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="action" value="publish_report">
    <button class="btn-ghost" type="submit" style="border-color:var(--good);color:var(--good)">Publish report + email client</button>
    <% if (report && report.is_published) { %>
      <a href="/report/<%= order.order_code %>?t=<%= order.access_token %>" target="_blank" style="margin-left:10px;color:var(--brand);font-weight:700">View published report ↗</a>
    <% } %>
  </form>
</div>

<script>
  // Publishing emails the client, so confirm first. Listener rather than an
  // inline onsubmit= so the CSP can keep script-src-attr 'none'.
  document.getElementById('publish_form').addEventListener('submit', function (e) {
    if (!confirm('Publish report and email it to the client?')) e.preventDefault();
  });

  // Confirming payment authorises real spending — make it deliberate.
  var confirmPay = document.getElementById('confirm_payment_form');
  if (confirmPay) {
    confirmPay.addEventListener('submit', function (e) {
      if (!confirm('Have you matched this payment against the bank statement?\n\nConfirming queues the order and tells a shopper to start spending.')) {
        e.preventDefault();
      }
    });
  }
  // Sending the link commits us to a quoted figure — confirm the numbers first.
  var sendLink = document.getElementById('send_link_form');
  if (sendLink) {
    sendLink.addEventListener('submit', function (e) {
      var fee = Number(sendLink.service_fee.value || 0);
      var dep = Number(sendLink.product_deposit.value || 0);
      var total = (fee + dep).toLocaleString('en-IN');
      if (!confirm('Email the client a payment link for ₹' + total + '?\n\nThis is the amount they will be asked to pay.')) {
        e.preventDefault();
      }
    });
  }

  var rejectPay = document.getElementById('reject_payment_form');
  if (rejectPay) {
    rejectPay.addEventListener('submit', function (e) {
      if (!confirm('Reject this payment claim and email the client?')) e.preventDefault();
    });
  }
</script>

<%- include('_layout-bottom') %>
